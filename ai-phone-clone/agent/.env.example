# LiveKit Cloud (projet à votre nom) — wss://<projet>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI (projet dédié, budget plafonné)
OPENAI_API_KEY=
# Modèle de traduction (qualité) et repli économique si le premier est refusé
REALTIME_MODEL=gpt-realtime-2
REALTIME_FALLBACK_MODEL=gpt-realtime-2.1-mini
# Modèle texte pour le résumé de fin d'appel
SUMMARY_MODEL=gpt-5-mini

# Supabase : URL du projet + clé service_role (jamais côté navigateur)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Réglages facultatifs (valeurs par défaut ci-dessous)
# TRANSCRIBE_MODEL=gpt-live-transcribe
# REALTIME_REASONING_EFFORT=minimal   # vide = ne pas envoyer le champ
# DEFAULT_VOICE=marin
# VAD_SILENCE_MS=350
# VAD_PREFIX_MS=250
# VAD_THRESHOLD=0.5
# RECONNECT_GRACE_S=30
# UTTERANCE_FLUSH_S=2
# CAPTIONS_ONLY_LANGS=wo
# MAX_CONTEXT_ITEMS=10
