# Lien Interprète - environment variables. Copy to .env.local and fill in.
# Never commit real values. Variables without NEXT_PUBLIC_ stay on the server.

# App
NEXT_PUBLIC_APP_URL=                 # e.g. http://localhost:3000 or https://your-domain (used in share links + Stripe return URLs)

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server only: webhooks, guest join, call status

# LiveKit Cloud (Project settings > Keys)
LIVEKIT_URL=                         # wss://<project>.livekit.cloud (server SDK converts to https)
NEXT_PUBLIC_LIVEKIT_URL=             # same wss:// URL, returned to browsers
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=                  # also verifies /api/webhooks/livekit

# Stripe (test mode first: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayDunya (Wave / Orange Money) - stub, not used yet
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Rate limiting (TODO: replace the in-memory limiter on /api/join)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
