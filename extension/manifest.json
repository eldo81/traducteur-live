{
  "manifest_version": 3,
  "name": "Interprète Live — Meet, WhatsApp, Teams, Zoom",
  "version": "1.3.0",
  "description": "Interprète simultané anglais ⇄ français dans vos visioconférences : l'interlocuteur n'entend que l'anglais, vous entendez le français.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://meet.google.com/*",
    "https://web.whatsapp.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://app.zoom.us/*",
    "https://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Interprète Live — ouvrir",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://web.whatsapp.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://web.whatsapp.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://app.zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "minimum_chrome_version": "111"
}
